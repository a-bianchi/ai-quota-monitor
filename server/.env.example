# Generar tokens propios; no publicar este archivo con secretos reales.
DEVICE_TOKEN=
COLLECTOR_TOKEN=
# Panel web (opcional). Usuario y hash de la contraseña; el hash se genera con `make panel-password`.
# Nunca va la contraseña en texto plano. Ver docs/panel.es.md
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
# Clave maestra para cifrar las credenciales cargadas desde el panel. Generar con `openssl rand -base64 32`.
# Si se pierde o cambia, hay que volver a cargar esas credenciales.
MASTER_KEY=
HTTP_PORT=8080
HOST_BIND=127.0.0.1
POLL_INTERVAL=5m
STALE_AFTER=15m
CONFIG_NAME=config.json
# Opcional si la key se carga desde el panel; lo guardado en el panel tiene prioridad.
OPENROUTER_PERSONAL_KEY=
# Valor de la cookie WorkosCursorSessionToken de cursor.com; ver docs/providers/cursor.md
CURSOR_WORK_SESSION=

# Variables opcionales del recolector local; no necesarias en homelab
QUOTA_API_URL=http://localhost:8080
CODEX_POLL_INTERVAL=5m
CODEX_BIN=codex

# COLLECTOR_TOKEN permite ingresar datos, iniciar/consultar logins de providers y leer /usage.
